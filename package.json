{
  "name": "osone-app",
  "private": true,
  "version": "1.6.3",
  "description": "OSONE G5 - Sistema Operacional Neural",
  "author": "OSONE",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerobob623-bit/OSONE-AI.git"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "electron": "electron .",
    "build:desktop": "npm run build && electron-builder --win --linux",
    "release": "npm run build && electron-builder --win --linux --publish always",
    "build:vercel": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-build/server.cjs && node scripts/conferir-build-vercel.mjs",
    "test:vercel-runtime": "node scripts/conferir-build-vercel.mjs",
    "test:billing": "tsx scripts/conferir-billing.ts",
    "test:stripe-config": "tsx scripts/conferir-stripe-config.ts",
    "stripe:auditar-clientes": "tsx scripts/auditar-clientes-stripe.ts",
    "stripe:corrigir-webhook": "tsx scripts/corrigir-webhook-stripe.ts",
    "test:legal": "node scripts/conferir-legal.mjs",
    "test:zap-gatilho": "node scripts/conferir-zap-gatilho.mjs",
    "test:tiktok-assinatura": "node scripts/conferir-tiktok-assinatura.mjs",
    "test:google-home": "node scripts/conferir-google-home.mjs && node scripts/conferir-google-home-cloud.mjs",
    "test:elevenlabs": "node scripts/conferir-elevenlabs.mjs",
    "test:voz-natural": "node scripts/conferir-voz-natural.mjs",
    "test:github-code": "node scripts/conferir-github-code.mjs",
    "test:code-layout": "node scripts/conferir-layout-code.mjs",
    "test:code-fullstack": "node scripts/conferir-fullstack-code.mjs",
    "test:code-multiarquivo": "node scripts/conferir-projeto-multiarquivo.mjs",
    "test:code-modulos": "node scripts/conferir-preview-modulos.mjs",
    "test:code-enxame": "node scripts/conferir-enxame-code.mjs",
    "test:code-voz": "node scripts/conferir-voz-code.mjs",
    "test:canto": "node scripts/conferir-canto-completo.mjs",
    "test:sons": "node scripts/conferir-biblioteca-sons.mjs",
    "test:chat-code": "node scripts/conferir-chat-code.mjs",
    "test:ollama-code": "node --import tsx scripts/conferir-ollama-code.mjs",
    "test:pesquisa": "node scripts/conferir-osone-pesquisa.mjs",
    "test:cameras": "node scripts/conferir-cameras.mjs",
    "test:leitura-chat": "node scripts/conferir-leitura-de-chat.mjs",
    "test:tela-inicial": "node scripts/conferir-tela-inicial.mjs",
    "test:franqueza": "node scripts/conferir-franqueza.mjs",
    "test:arquivos-agente": "node scripts/conferir-arquivos-do-agente.mjs",
    "test:youtube": "node scripts/conferir-youtube.mjs",
    "test:cowork-memory": "tsx scripts/conferir-memoria-cowork.ts",
    "test:cowork-checkup": "tsx scripts/conferir-checkup-cowork.ts",
    "test:cowork-performance": "node scripts/conferir-desempenho-cowork.mjs",
    "test:cowork-teaching": "tsx scripts/conferir-ensino-cowork.ts",
    "test:cowork-teaching-ui": "node scripts/conferir-ensino-cowork-na-tela.mjs",
    "test:cowork-integration": "node scripts/conferir-cowork-integracao.mjs",
    "test:cowork-core": "npm run test:cowork-integration && npm run test:cowork-memory && npm run test:cowork-checkup && npm run test:cowork-performance && npm run test:cowork-teaching && node scripts/conferir-agente-autonomo.mjs && node scripts/conferir-visao.mjs && node scripts/conferir-visao-cega.mjs && node scripts/conferir-caminho-do-sistema.mjs && node scripts/conferir-abrir-na-tela-do-agente.mjs",
    "test:code-runtimes": "node scripts/conferir-runtimes-code.mjs",
    "android:prepare": "node scripts/preparar-android.mjs",
    "android:build": "cd android && npx bubblewrap build --manifest=twa-manifest.json --skipPwaValidation",
    "publicar": "node scripts/publicar.mjs",
    "baixar-voz": "node scripts/baixar-piper.mjs",
    "baixar-voz-natural": "node scripts/baixar-supertonic.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-desktop server-build",
    "lint": "tsc --noEmit"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.osone.app",
    "productName": "OSONE G5",
    "copyright": "Copyright © 2026 OSONE",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "src/documentos_osone/**/*",
      "docs/THIRD_PARTY_NOTICES.md",
      "vendor/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.{md,markdown,ts,map}",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.d.ts"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/onnxruntime-node/**",
      "vendor/piper/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "zerobob623-bit",
      "repo": "OSONE-AI",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSONE G5"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@google/genai": "^1.29.0",
    "@mediapipe/tasks-vision": "^1.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "6.7.22",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3-geo": "^3.1.1",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-node": "^1.27.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tiktok-live-connector": "2.4.3",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.20.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@jimp/plugin-color": "^0.22.12",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
